# Konfiguracja Construction CMS
# SKOPIUJ ten plik jako .env i dostosuj wartości

# Baza danych (SQLite)
DATABASE_URL=sqlite:///data/cms.db

# Bezpieczeństwo - ZMIEŃ przed produkcją!
SECRET_KEY=twoj-bardzo-dlugi-i-trudny-klucz-min-32-znaki

# Konto administratora
ADMIN_EMAIL=admin@firma.pl
ADMIN_PASSWORD=admin123

# Włączone moduły (oddzielone przecinkami)
MODULES_ENABLED=onepage,blog,shop

# Port zewnętrzny (85 = nie koliduje z 80/443)
CMS_PORT=85
